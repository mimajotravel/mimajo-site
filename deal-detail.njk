---
layout: layouts/base.njk
pagination:
  data: deals
  size: 1
  alias: deal
permalink: "/deal-{{ deal.slug }}.html"
eleventyComputed:
  title: "{{ deal.title }}"
  description: "{{ deal.meta }}"
---

<article class="article-hero">
  <a href="/deals.html" class="pill-link" style="font-size:0.85rem;">← Back to Deals</a>
  <span class="deal-tag" style="margin-top:20px;">{{ deal.tag }}</span>
  <h1 style="font-size:clamp(1.8rem, 4vw, 2.6rem);">{{ deal.title }}</h1>
  <p class="article-meta">{{ deal.meta }}</p>
  <img src="{{ deal.image }}?w=1000" alt="{{ deal.title }}">
</article>

<div class="article-body">
  {% if deal.bodyHtml %}
    {{ deal.bodyHtml | safe }}
  {% else %}
    <p>Full details for this deal are coming soon — check current pricing and availability directly with the merchant below.</p>
  {% endif %}

  <div style="background:var(--sand-deep); border-radius:var(--radius); padding:28px; margin-top:32px; display:flex; align-items:center; justify-content:space-between; gap:20px; flex-wrap:wrap;">
    <div>
      <div class="deal-price" style="font-size:1.6rem;"><span class="was">{{ deal.was_price }}</span>{{ deal.price }}</div>
      <p style="margin:4px 0 0; color:var(--ink-soft); font-size:0.85rem;">Price shown is indicative — confirm on the merchant's site.</p>
    </div>
    <a href="{{ deal.cta_link }}" class="btn-book" style="font-size:1rem; padding:14px 32px;">Book Now →</a>
  </div>
</div>
