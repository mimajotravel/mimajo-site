---
layout: layouts/base.njk
pagination:
  data: magazineArticles
  size: 1
  alias: article
permalink: "/magazine-{{ article.slug }}.html"
eleventyComputed:
  title: "{{ article.title }}"
  description: "{{ article.excerpt }}"
---

<article class="article-hero">
  <a href="/magazine.html" class="pill-link" style="font-size:0.85rem;">← Back to Magazine</a>
  <span class="mag-tag {{ article.tagClass }}" style="margin-top:20px;">{{ article.category }}</span>
  <h1 style="font-size:clamp(1.8rem, 4vw, 2.6rem);">{{ article.title }}</h1>
  <p class="article-meta">Written by {{ article.author }} · Published {{ article.date | readableDate }} · {{ article.read_time }} min read</p>
  <img src="{{ article.image }}?w=1000" alt="{{ article.title }}">
</article>

<div class="article-body">
{{ article.bodyHtml | safe }}
  <p>Full deal-checked flight and hotel packages are on the <a href="/deals.html">Deals page</a> — we refresh them daily.</p>
</div>
