---
layout: layouts/base.njk
title: "Enquire"
description: "Tell us your destination, dates and budget — we'll hunt down a deal and email it to you."
permalink: "/enquiry.html"
---

<section class="section" style="padding-top:48px">
  <div class="section-head" style="justify-content:center; text-align:center; flex-direction:column; align-items:center;">
    <h2 style="color:var(--mi)">Tell us what you're after</h2>
    <p>Destination, dates, budget — we'll hunt down a deal and email it to you.</p>
  </div>

  <form class="form-card" action="https://formspree.io/f/xoeqgbnz" method="POST">
    <div class="form-row">
      <label for="name">Full name</label>
      <input type="text" id="name" name="name" required>
    </div>
    <div class="form-row">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required>
    </div>
    <div class="form-row">
      <label for="destination">Destination</label>
      <input type="text" id="destination" name="destination" placeholder="e.g. Bali, Tokyo, anywhere in Japan">
    </div>
    <div class="form-row">
      <label for="dates">Travel dates</label>
      <input type="text" id="dates" name="dates" placeholder="e.g. Dec 10–17, or flexible">
    </div>
    <div class="form-row">
      <label for="budget">Budget per person</label>
      <input type="text" id="budget" name="budget" placeholder="e.g. under $600">
    </div>
    <div class="form-row">
      <label for="notes">Anything else we should know?</label>
      <textarea id="notes" name="notes" rows="4"></textarea>
    </div>
    <button type="submit" class="btn-submit">Send Enquiry</button>
  </form>
</section>
